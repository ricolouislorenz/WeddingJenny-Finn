# Lokale Secrets für `npm run preview` – als .dev.vars kopieren (wird nicht eingecheckt).
# Für Cloudflare Pages: npx wrangler pages secret put SITE_PASSWORD (usw.) oder im Dashboard eintragen.
SITE_PASSWORD=Hochzeit2027
ADMIN_PASSWORD=Admin
AUTH_SECRET=bitte-durch-lange-zufallszeichenkette-ersetzen
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key aus Supabase → Project Settings → API Keys
SUPABASE_ANON_KEY=sb_publishable_...
# Secret key – nur für den Admin-Bereich, niemals im Frontend verwenden
SUPABASE_SERVICE_KEY=sb_secret_...
